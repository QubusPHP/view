{
    "name": "qubus/view",
    "type": "library",
    "description": "Scaffold: A fast PHP templating engine.",
    "keywords": [
        "template",
        "templating",
        "twig",
        "blade",
        "mustache",
        "dwoo",
        "raintpl"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Parker",
            "email": "joshua@joshuaparker.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "qubus/security": "^4",
        "qubus/support": "^4"
    },
    "require-dev": {
        "qubus/qubus-coding-standard": "^2"
    },
    "autoload": {
        "psr-4": {
            "Qubus\\View\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qubus\\Tests\\View\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --min=50 --colors=always",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
